# ============================================================
# Can Limoncello — Server-Einstellungen (Apache, Hostpoint)
# Browser-Caching: Fotos/Videos/Schriften werden beim Besucher
# gespeichert, HTML 5 Minuten (Änderungen sind spätestens nach 5 Min. sichtbar).
# CSS/JS werden 1 Jahr gespeichert — deshalb in den HTML-Seiten
# immer mit Versionsnummer einbinden (z. B. site.css?v=20261104)
# und die Nummer bei jeder Änderung an CSS/JS erhöhen.
# Alle Regeln sind in <IfModule> gekapselt: fehlt ein Modul,
# wird die Regel ignoriert statt die Seite zu brechen.
# ============================================================

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
